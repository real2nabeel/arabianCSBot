# Discord
DISCORD_TOKEN=your-bot-token-here
LOGGING_CHANNEL_ID=887016921705349190
# The only server the bot is allowed to run in (right-click the server icon
# with Developer Mode on -> Copy Server ID)
GUILD_ID=your-server-id-here

# CS 1.6 game server (used by /ip for live player count)
SERVER_IP=151.80.47.182
SERVER_PORT=27015

# MySQL rank databases (two schemas on the same server, sharing credentials):
#   DB_NAME_LIVE -> live/current ranking  (used by /rankstats, /top, ...)
#   DB_NAME      -> historical ranking    (used by /rankstats-history, /top-history, ...)
# Under Docker, 127.0.0.1 points at the bot's own container. Use instead:
#   host.docker.internal -> MySQL running on the Docker host
#   mysql                -> the optional `local-db` compose service
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-db-password
DB_NAME_LIVE=liverank
DB_NAME=rankTest
# Bot-owned schema for the Discord activity leveling system (XP + level roles).
# Kept separate from the game ranking data; auto-created on startup.
DB_NAME_BOT=arabianbot

# --- Discord activity leveling (separate from in-game rank) --------------- #
# Text XP: a random amount in [min, max] per message, at most once per cooldown
# (seconds); messages shorter than MIN_MESSAGE_LENGTH chars earn nothing.
TEXT_XP_MIN=15
TEXT_XP_MAX=25
TEXT_XP_COOLDOWN=60
MIN_MESSAGE_LENGTH=3
# Voice XP: granted every VOICE_TICK_SECONDS to members who are not deafened,
# only when at least VOICE_MIN_HUMANS non-bot members share the channel.
VOICE_XP_PER_TICK=10
VOICE_TICK_SECONDS=60
VOICE_MIN_HUMANS=2
# Channels (comma- or space-separated IDs) where text earns no XP.
XP_EXCLUDED_CHANNELS=
# Channel to announce level-ups in. Leave blank to reply where the message was
# sent (text) / stay silent (voice).
LEVELUP_CHANNEL_ID=

# --- Server management -------------------------------------------------- #
# Private staff channel for member, message, channel and role event logs.
# Blank disables server event logging. Restart Python after config changes;
# Docker requires container recreation (a plain restart keeps the old env).
SERVER_LOG_CHANNEL_ID=
# Optional separate ban/unban event log; blank uses SERVER_LOG_CHANNEL_ID.
MOD_LOG_CHANNEL_ID=
# Channel/category IDs excluded from content logging (includes child threads).
# Both log channels are always excluded to avoid recursive logging.
LOG_EXCLUDED_CHANNELS=
# Blank disables welcome messages. Supported tokens: {mention}, {user},
# {server}, {count}. Only the joining member can be mentioned.
WELCOME_CHANNEL_ID=
WELCOME_MESSAGE="Welcome {mention} to {server}! Please read the server rules."
# Comma-separated member role IDs; blank disables automatic assignment.
# Bots are skipped; members receive roles only after membership screening.
# Managed roles, staff roles, @everyone and roles above/equal to the bot are skipped.
AUTO_ROLE_IDS=

# --- Live dashboard and opt-in activity alerts -------------------------- #
# Text channels in GUILD_ID. Blank disables each feature. The DD2 dashboard and
# top-50 image are created in DASHBOARD_CHANNEL_ID and reused after restart.
DASHBOARD_CHANNEL_ID=
ACTIVITY_ALERT_CHANNEL_ID=
# Members select this role through Discord's Channels & Roles menu.
# Do NOT include it in AUTO_ROLE_IDS; subscriptions are opt-in.
ACTIVITY_ALERT_ROLE_ID=
SERVER_POLL_SECONDS=30
DASHBOARD_REFRESH_SECONDS=60
LEADERBOARD_REFRESH_SECONDS=300
ACTIVITY_HUMAN_THRESHOLD=15
ACTIVITY_SUSTAIN_SECONDS=120
ACTIVITY_REARM_BELOW=4
ACTIVITY_REARM_SECONDS=300
ACTIVITY_COOLDOWN_SECONDS=7200

# --- Server activity graph and admin activity table --------------------- #
# Private staff channel for both: one graph with a time-span dropdown (24 hours
# up to all time) and the admin hours table, redrawn every
# ACTIVITY_REFRESH_SECONDS. Blank disables the posted messages; /server-activity
# and /admin-activity still work for Manage Server members. The bot refuses a
# channel @everyone can see.
STAFF_ACTIVITY_CHANNEL_ID=
# Admins are rank-table players whose access flags contain this letter.
ADMIN_FLAG=c
ACTIVITY_REFRESH_SECONDS=600
# Raw 30-second samples (used for the 24-hour view) older than this are deleted.
# Hourly totals behind every longer view are kept forever. Minimum 2.
ACTIVITY_HISTORY_DAYS=30
# Hours from UTC for graph times and for where one day ends (3 = Arabia Standard Time).
ACTIVITY_UTC_OFFSET=3

# --- Highlight clips (cogs/clips.py, host job in clips/) ------------------ #
# Blank CLIPS_REVIEW_CHANNEL_ID turns the feature off. New clips are posted there with 👍/❌; a 👍 from a member
# with one of CLIPS_APPROVER_ROLE_IDS (or Administrator) queues the clip, a ❌ skips it.
CLIPS_REVIEW_CHANNEL_ID=
CLIPS_APPROVER_ROLE_IDS=
# Host folders mounted into the container (docker-compose.yml): finished clips, and YouTube/TikTok token files.
CLIPS_HOST_DIR=/home/nabeel/clips/out
CLIPS_SECRETS_DIR=/home/nabeel/clips/secrets
# Shared with the host job for /clips-run (read-write).
CLIPS_CONTROL_HOST_DIR=/home/nabeel/clips/control
# Where to post approved clips (facebook, instagram, youtube, tiktok), how often, and when (server time).
CLIPS_PLATFORMS=facebook,instagram
CLIPS_POSTS_PER_DAY=2
CLIPS_POST_GAP_MINUTES=240
CLIPS_POST_HOURS=18-22
# Post text. Fields: {hook} (first line, from the clip's best moment), {question}, {player}, {server}, {hashtags}
# (these plus one for the kind of moment), and the older {summary} {map}; \n is a new line. No emojis for now.
CLIPS_CAPTION={hook}\n{question}\n\n{player} on Arabian Servers · Dust2 since 2013\nJoin us: connect {server}\n\n{hashtags}
CLIPS_HASHTAGS=#cs16 #counterstrike #dust2 #كاونتر_سترايك
# Address shown in captions (default SERVER_IP:SERVER_PORT).
CLIPS_SERVER_ADDRESS=
# Meta system-user token (never expires) with the Page and the Instagram account assigned.
META_TOKEN=
META_PAGE_ID=
META_IG_ID=
# YouTube: authorized-user token JSON in CLIPS_SECRETS_DIR. Uploads are private until Google audits the app.
YOUTUBE_PRIVACY=private
# TikTok: tiktok_client (client_key=/client_secret=) and tiktok_token.json in CLIPS_SECRETS_DIR.
# inbox = to the app's drafts; direct = posted, but only visible to you until TikTok audits the app.
TIKTOK_MODE=inbox
